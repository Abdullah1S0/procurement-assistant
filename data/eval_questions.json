  {
    "id": 4,
    "question": "Which fiscal quarter had the highest total spending?",
    "lang": "en",
    "reference_pipeline": [
      {
        "$match": {
          "is_duplicate_row": false
        }
      },
      {
        "$group": {
          "_id": "$fiscal_quarter_label",
          "spend": {
            "$sum": "$total_price"
          }
        }
      },
      {
        "$sort": {
          "spend": -1
        }
      },
      {
        "$limit": 1
      }
    ],
    "expected_result": [
      {
        "_id": "FY14-15 Q4",
        "spend": 28801762780.47
      }
    ]
  },
  {
