[
  {
    "id": 1,
    "question": "How many purchase orders were created in fiscal year 2013-2014?",
    "lang": "en",
    "reference_pipeline": [
      {
        "$match": {
          "fiscal_year": "2013-2014"
        }
      },
      {
        "$group": {
          "_id": "$po_key"
        }
      },
      {
        "$count": "orders"
      }
    ],
    "expected_result": [
      {
        "orders": 68749
      }
    ]
  },
