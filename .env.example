# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=procurement
MONGO_COLLECTION=purchases

# --- LLM (provider factory in backend/app/llm.py) ---
# Switch provider with one line: LLM_PROVIDER=openai + LLM_MODEL=... + OPENAI_API_KEY (pip install langchain-openai)
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
# Fallback if gpt-oss-120b is unavailable/rate-limited: openai/gpt-oss-20b (confirmed live via GET /v1/models on 2026-10-26; llama-3.3-70b-versatile has been removed from Groq's list)
# Optional cheaper model for the understand/answer nodes (separate Groq rate-limit bucket), e.g. openai/gpt-oss-20b
LLM_FAST_MODEL=
LLM_REASONING_EFFORT=low
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Agent / API ---
QUERY_MAX_TIME_MS=15000
QUERY_ROW_LIMIT=200
AGENT_MAX_RETRIES=2
LLM_MAX_RETRIES=4
CORS_ORIGINS=*
LOG_LEVEL=INFO
